{
  "name": "shouldnt-wouldnt",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Think Twice Before You Share.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle-content.mjs && node scripts/make-icons.mjs",
    "test": "tsc -p tsconfig.json && node --test dist/tests/*.test.js",
    "pretest": "node scripts/make-icons.mjs",
    "accuracy": "tsc -p tsconfig.json && node scripts/accuracy.mjs",
    "package": "node scripts/package.mjs",
    "browsers": "node scripts/install-browser.mjs",
    "test:browser": "node --test --test-concurrency=1 --test-timeout=120000 tests/browser/privacy.test.mjs tests/browser/behavior.test.mjs tests/browser/release.test.mjs",
    "bench": "node scripts/bench.mjs",
    "store-assets": "node scripts/store-assets.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.7.3"
  }
}
